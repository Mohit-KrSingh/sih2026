# EduTrace Production Environment Configuration
ENV=production
PORT=80
DEMO_MODE=true
AUTO_SEED=true

# Database (PostgreSQL 16)
POSTGRES_USER=apaar
POSTGRES_PASSWORD=replace-with-generated-db-password
POSTGRES_DB=apaar_db

# Cache (Redis 7)
REDIS_URL=redis://redis:6379/0

# Production Cryptographic Secrets (generate using python scripts/generate_secrets.py)
JWT_SECRET=replace-with-generated-jwt-secret
FERNET_KEY=replace-with-generated-fernet-key
ED25519_PRIVATE_KEY=replace-with-generated-ed25519-seed

# Domain & Reverse Proxy (Set your Namecheap domain here, e.g. edutrace.me)
DOMAIN_NAME=localhost
FRONTEND_URL=http://localhost

# File Storage
STORAGE_DIR=/app/storage/uploads
