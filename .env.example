# Environment Configuration
ENV=development
PORT=8000
HOST=0.0.0.0
DEMO_MODE=true

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://apaar:apaar_password@localhost:5432/apaar_db
TEST_DATABASE_URL=postgresql+psycopg://apaar:apaar_password@localhost:5432/apaar_test_db

# Cache (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=super-secret-development-jwt-key-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FERNET_KEY=0123456789abcdef0123456789abcdef0123456789a=
ED25519_PRIVATE_KEY=development-ed25519-private-seed-32bytes-len!!

# File Storage
STORAGE_DIR=./storage/uploads

# Integration Client Types ("mock" or "http")
APAAR_CLIENT_TYPE=mock
AICTE_MASTER_CLIENT_TYPE=mock
OTP_SENDER_TYPE=mock
IDENTITY_VERIFIER_TYPE=mock
STORAGE_TYPE=mock

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
